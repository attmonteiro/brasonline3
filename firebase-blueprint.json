{
  "entities": {
    "Product": {
      "collection": "products",
      "fields": {
        "title": { "type": "string", "required": true },
        "price": { "type": "number", "required": true },
        "suggestedRetailPrice": { "type": "number", "required": false },
        "minQuantity": { "type": "number", "required": true },
        "category": { "type": "string", "required": true },
        "colors": { "type": "array", "items": { "type": "string" }, "required": true },
        "sizes": { "type": "array", "items": { "type": "string" }, "required": true },
        "images": { "type": "array", "items": { "type": "string" }, "required": true },
        "loja_id": { "type": "string", "required": true },
        "storeName": { "type": "string", "required": true },
        "region": { "type": "string", "required": true },
        "createdAt": { "type": "timestamp", "required": true },
        "createdBy": { "type": "string", "required": true }
      }
    },
    "Store": {
      "collection": "stores",
      "fields": {
        "ownerUid": { "type": "string", "required": true },
        "nome": { "type": "string", "required": true },
        "endereco": { "type": "string", "required": true },
        "contato": { "type": "string", "required": true },
        "description": { "type": "string", "required": false },
        "category": { "type": "string", "required": false },
        "logoUrl": { "type": "string", "required": false },
        "region": { "type": "string", "required": false },
        "updatedAt": { "type": "timestamp", "required": true }
      }
    },
    "Subscription": {
      "collection": "subscriptions",
      "fields": {
        "userId": { "type": "string", "required": true },
        "userRole": { "type": "string", "required": true },
        "status": { "type": "string", "required": true },
        "plan": { "type": "string", "required": true },
        "updatedAt": { "type": "timestamp", "required": true }
      }
    }
  }
}
